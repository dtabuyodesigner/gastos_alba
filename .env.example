# Gastos Alba — variables de entorno del cliente (Vite)
#
# IMPORTANTE
# - Solo variables con prefijo VITE_ llegan al navegador. Todo lo que pongas
#   aqui es PUBLICO una vez desplegado.
# - La clave anon de Supabase esta pensada para vivir en el frontend: la
#   seguridad real la dan las politicas RLS, no el secreto de la clave.
# - NUNCA pongas aqui la service_role key ni ninguna credencial de servidor.

# URL del proyecto Supabase de Gastos Alba (proyecto propio, NO el de La Libreta de Marcos)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave publica anon (Project Settings -> API -> anon/public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Nombre del bucket privado de fotos de tickets
VITE_SUPABASE_TICKETS_BUCKET=tickets
